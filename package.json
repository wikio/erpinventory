{
  "name": "erpinventory-sari-systeme",
  "version": "1.0.0",
  "description": "SARI Système - Medical Equipment & Consumables Distribution Management System (Bilingual Arabic / French / English, Offline-First PWA)",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node scripts/dev-server.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "npm run build && node server.js",
    "start:server": "node server.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "db:migrate": "node scripts/migrate-db.js",
    "auth:reset-admin": "node scripts/reset-admin-password.js",
    "test:e2e": "npm run build && playwright test",
    "db:validate": "node scripts/validate-external-db.js"
  },
  "keywords": [
    "erp",
    "medical",
    "inventory",
    "tenders",
    "import-export",
    "algeria",
    "pwa",
    "indexeddb"
  ],
  "author": "SARI Système Team",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "@capacitor/ios": "^7.6.8",
    "@zxing/browser": "^0.2.1",
    "chart.js": "^4.4.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide": "^1.31.0",
    "mongodb": "^6.18.0",
    "mysql2": "^3.14.3",
    "nodemailer": "^9.0.5",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "read-excel-file": "^9.3.10"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.2.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "@zxing/library": "0.21.3"
  }
}
